@article{belaroussi_intensity_2006,
	title = {Intensity non-uniformity correction in {MRI}: Existing methods and their validation},
	volume = {10},
	issn = {13618415},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1361841505000976},
	doi = {10.1016/j.media.2005.09.004},
	shorttitle = {Intensity non-uniformity correction in {MRI}},
	abstract = {Magnetic resonance imaging is a popular and powerful non-invasive imaging technique. Automated analysis has become mandatory to eﬃciently cope with the large amount of data generated using this modality. However, several artifacts, such as intensity nonuniformity, can degrade the quality of acquired data. Intensity non-uniformity consists in anatomically irrelevant intensity variation throughout data. It can be induced by the choice of the radio-frequency coil, the acquisition pulse sequence and by the nature and geometry of the sample itself. Numerous methods have been proposed to correct this artifact. In this paper, we propose an overview of existing methods. We ﬁrst sort them according to their location in the acquisition/processing pipeline. Sorting is then reﬁned based on the assumptions those methods rely on. Next, we present the validation protocols used to evaluate these diﬀerent correction schemes both from a qualitative and a quantitative point of view. Finally, availability and usability of the presented methods is discussed.},
	pages = {234--246},
	number = {2},
	journaltitle = {Medical Image Analysis},
