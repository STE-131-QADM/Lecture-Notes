@article{mrazova_not_2017,
	title = {Not So Demanding: Demand Structure and Firm Behavior},
	volume = {107},
	issn = {0002-8282},
	url = {https://pubs.aeaweb.org/doi/10.1257/aer.20160175},
	doi = {10.1257/aer.20160175},
	shorttitle = {Not So Demanding},
	abstract = {We show that any well-behaved demand function can be represented by its “demand manifold,” a smooth curve that relates the elasticity and convexity of demand. This manifold is a sufficient statistic for many comparative statics questions; leads naturally to characterizations of new families of demand functions that nest most of those used in applied economics; and connects assumptions about demand structure with firm behavior and economic performance. In particular, the demand manifold leads to new insights about industry adjustment with heterogeneous firms, and can be empirically estimated to provide a quantitative framework for measuring the effects of globalization. ({JEL} F12, L11)},
	pages = {3835--3874},
	number = {12},
	journaltitle = {American Economic Review},
